# Supabase (https://supabase.com/dashboard → Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=    # 공개 가능한 키 (MVP에서는 미사용, 2단계 로그인에서 사용)
SUPABASE_SECRET_KEY=         # 서버 전용. NEXT_PUBLIC_ 금지, 절대 커밋 금지
SUPABASE_JWKS_URL=           # JWT 검증용 공개키 주소 (2단계에서 사용 예정)

# MVP 임시 로그인 (2단계에서 Supabase Auth로 교체)
ADMIN_PASSWORD=              # 관리자 공용 비밀번호
AUTH_SECRET=                 # 세션 쿠키 서명용 랜덤 문자열 (openssl rand -base64 32). 절대 커밋 금지
# NEXT_PUBLIC_SITE_URL=      # (선택) 공유 링크의 기준 주소. 비우면 요청 호스트를 사용
